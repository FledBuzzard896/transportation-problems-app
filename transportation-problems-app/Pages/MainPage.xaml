<Page x:Class="transportation_problems_app.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:transportation_problems_app.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="Калькулятор транспортных задач" FontSize="24" Margin="15" Grid.Row="0"/>
        <ComboBox x:Name="SolutionChoiceCombo" Width="200" Height="24" HorizontalAlignment="Right" Margin="0,0,15,0" SelectedIndex="0" Grid.Row="1">
            <ComboBoxItem Content="Метод северо-западного угла"/>
            <ComboBoxItem Content="Метод минимальных элементов"/>
        </ComboBox>
        <Grid x:Name="MainGrid" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Пункты поставки" FontSize="18" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"/>
            <TextBlock Text="Пункты потребления" FontSize="18" Margin="5" HorizontalAlignment="Center" Grid.Column="1" Grid.ColumnSpan="5" Grid.Row="0"/>
            <TextBlock Text="Запасы" FontSize="18" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="6" Grid.Row="0" Grid.RowSpan="2"/>
            <TextBlock Text="Потребности" FontSize="18" Margin="5" HorizontalAlignment="Center" Grid.Column="0" Grid.Row="5"/>

            <TextBlock Text="B1" FontSize="18" Margin="5" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="1"/>
            <TextBlock Text="B2" FontSize="18" Margin="5" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="2"/>
            <TextBlock Text="B3" FontSize="18" Margin="5" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="3"/>
            <TextBlock Text="B4" FontSize="18" Margin="5" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="4"/>
            <TextBlock Text="B5" FontSize="18" Margin="5" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="5"/>

            <TextBlock Text="A1" FontSize="18" Margin="5" Grid.Row="2" Grid.Column="0"/>
            <TextBlock Text="A2" FontSize="18" Margin="5" Grid.Row="3" Grid.Column="0"/>
            <TextBlock Text="A3" FontSize="18" Margin="5" Grid.Row="4" Grid.Column="0"/>

            <TextBox x:Name="A1B1" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="2" Grid.Column="1"/>
            <TextBox x:Name="A2B1" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="3" Grid.Column="1"/>
            <TextBox x:Name="A3B1" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="4" Grid.Column="1"/>
            <TextBox x:Name="A1B2" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="2" Grid.Column="2"/>
            <TextBox x:Name="A2B2" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="3" Grid.Column="2"/>
            <TextBox x:Name="A3B2" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="4" Grid.Column="2"/>
            <TextBox x:Name="A1B3" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="2" Grid.Column="3"/>
            <TextBox x:Name="A2B3" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="3" Grid.Column="3"/>
            <TextBox x:Name="A3B3" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="4" Grid.Column="3"/>
            <TextBox x:Name="A1B4" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="2" Grid.Column="4"/>
            <TextBox x:Name="A2B4" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="3" Grid.Column="4"/>
            <TextBox x:Name="A3B4" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="4" Grid.Column="4"/>
            <TextBox x:Name="A1B5" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="2" Grid.Column="5"/>
            <TextBox x:Name="A2B5" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="3" Grid.Column="5"/>
            <TextBox x:Name="A3B5" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="4" Grid.Column="5"/>

            <TextBox x:Name="ReservesA1" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="2" Grid.Column="6"/>
            <TextBox x:Name="ReservesA2" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="3" Grid.Column="6"/>
            <TextBox x:Name="ReservesA3" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="4" Grid.Column="6"/>

            <TextBox x:Name="NeedsB1" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="5" Grid.Column="1"/>
            <TextBox x:Name="NeedsB2" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="5" Grid.Column="2"/>
            <TextBox x:Name="NeedsB3" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="5" Grid.Column="3"/>
            <TextBox x:Name="NeedsB4" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="5" Grid.Column="4"/>
            <TextBox x:Name="NeedsB5" VerticalContentAlignment="Center" FontSize="14" Margin="3" PreviewTextInput="NumberTextBox_PreviewTextInput" Grid.Row="5" Grid.Column="5"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="15" Grid.Row="6" Grid.ColumnSpan="7">
                <Button x:Name="ClearBtn" Content="Очистить" Width="100" Height="24" Margin="0,0,10,0" Click="ClearBtn_Click"/>
                <Button x:Name="SolveBtn" Content="Решить" Width="100" Height="24" Click="SolveBtn_Click"/>
            </StackPanel>
            
        </Grid>
    </Grid>
</Page>
