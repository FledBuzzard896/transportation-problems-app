<Page x:Class="transportation_problems_app.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:transportation_problems_app.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Калькулятор транспортных задач" FontSize="24" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <ComboBox x:Name="MethodComboBox" Width="200" SelectedIndex="0">
                <ComboBoxItem Content="Метод северо-западного угла"/>
                <ComboBoxItem Content="Метод минимальных элементов"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="+ Строка" Click="AddRowBtn_Click" Padding="10,2" Margin="0,0,5,0"/>
            <Button Content="- Строка" Click="RemoveRowBtn_Click" Padding="10,2" Margin="0,0,15,0"/>
            <Button Content="+ Столбец" Click="AddColBtn_Click" Padding="10,2" Margin="0,0,5,0"/>
            <Button Content="- Столбец" Click="RemoveColBtn_Click" Padding="10,2"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="MainGrid" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15"/>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="ClearBtn" Content="Очистить" Width="100" Height="30" Margin="0,0,10,0" Click="ClearBtn_Click"/>
            <Button x:Name="SolveBtn" Content="Решить" Width="100" Height="30" Click="SolveBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
